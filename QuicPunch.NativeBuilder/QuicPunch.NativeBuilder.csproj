<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <None Include="msquic-msvc-fastfail.patch" CopyToOutputDirectory="PreserveNewest" />
    <None Include="msquic-ack-frequency.patch" CopyToOutputDirectory="PreserveNewest" />
    <None Include="msquic-callback-query.patch" CopyToOutputDirectory="PreserveNewest" />
    <None Include="msquic-openssl-pqc.patch" CopyToOutputDirectory="PreserveNewest" />
    <None Include="native-build.lock.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
