diff --git a/src/platform/tls_openssl.c b/src/platform/tls_openssl.c
index 2ef3a11..0f03337 100644
--- a/src/platform/tls_openssl.c
+++ b/src/platform/tls_openssl.c
@@ -2564,16 +2564,18 @@ CxPlatTlsInitialize(
     }
 
     //
-    // Both the fuzzer and the HandshakeSpecificLossPattern tests have some
-    // issues with larger key shares as introduced by ML-KEM support in openssl
-    // The former doesn't expect Client/Server hellos to span multiple udp datagrams
-    // and hits a buffer space assertion failure, while the latter times out on loss
-    // recovery.  So for now mimic the key shares that schannel offers to work around
-    // that
+    // Prefer the OpenSSL 3.5 hybrid post-quantum group while retaining a
+    // classical X25519 fallback for peers that do not support ML-KEM.
     //
-    // TODO: Remove this when the above tests are tolerant of addition of ML-KEM keyshares
-    //
-    SSL_set1_groups_list(TlsContext->Ssl, "secp256r1:x25519");
+    if (!SSL_set1_groups_list(TlsContext->Ssl, "X25519MLKEM768:X25519")) {
+        QuicTraceEvent(
+            TlsError,
+            "[ tls][%p] ERROR, %s.",
+            TlsContext->Connection,
+            "SSL_set1_groups_list failed");
+        Status = QUIC_STATUS_INTERNAL_ERROR;
+        goto Exit;
+    }
 
     if (!SSL_set_quic_tls_cbs(TlsContext->Ssl, OpenSslQuicDispatch, NULL)) {
         QuicTraceEvent(
@@ -3547,6 +3549,20 @@ CxPlatTlsParamGet(
             }
             HandshakeInfo->CipherSuite = SSL_CIPHER_get_protocol_id(Cipher);
             Status = CxPlatMapCipherSuite(HandshakeInfo);
+            if (CXPLAT_STRUCT_HAS_FIELD(QUIC_HANDSHAKE_INFO, *BufferLength, TlsGroup)) {
+                const char* NegotiatedGroup = SSL_get0_group_name(TlsContext->Ssl);
+                if (NegotiatedGroup != NULL) {
+                    if (strcmp(NegotiatedGroup, "X25519MLKEM768") == 0) {
+                        HandshakeInfo->TlsGroup = QUIC_TLS_GROUP_X25519MLKEM768;
+                    } else if (strcmp(NegotiatedGroup, "X25519") == 0) {
+                        HandshakeInfo->TlsGroup = QUIC_TLS_GROUP_X25519;
+                    } else if (strcmp(NegotiatedGroup, "secp256r1") == 0) {
+                        HandshakeInfo->TlsGroup = QUIC_TLS_GROUP_SECP256R1;
+                    } else if (strcmp(NegotiatedGroup, "secp384r1") == 0) {
+                        HandshakeInfo->TlsGroup = QUIC_TLS_GROUP_SECP384R1;
+                    }
+                }
+            }
             break;
         }
 
