<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../Release.props" />
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>QuicNet</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\QuicPunch\QuicPunch.csproj" />
    <ProjectReference Include="..\QuicNet.Geolocation\QuicNet.Geolocation.csproj" />
  </ItemGroup>
  <ItemGroup>
    <None Include="../QuicNet.Geolocation/Data/NOTICE.txt" Link="GEOLOCATION-NOTICE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="wwwroot\**" />
    <EmbeddedResource Include="Watch\wwwroot\**" />
    <EmbeddedResource Include="../native/media/NOTICE.txt" LogicalName="QuicNet.NativeVideo.NOTICE.txt" />
    <EmbeddedResource Include="../native/media/licenses/*.txt" Link="NativeVideoLicenses/%(Filename)%(Extension)" />
    <EmbeddedResource Include="Video/Probes.json" LogicalName="QuicNet.NativeVideo.Probes.json" />
    <None Include="runtimes/win-x64/native/*.dll" Link="%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" Condition="'$(RuntimeIdentifier)' == 'win-x64' or ('$(RuntimeIdentifier)' == '' and $([MSBuild]::IsOSPlatform('Windows')))" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="QuicNet" />
    <InternalsVisibleTo Include="QuicPunchTests" />
    <InternalsVisibleTo Include="QuicPunch.AndroidProbe" />
  </ItemGroup>
<ItemGroup><EmbeddedResource Include="Updates/release-public.pem" LogicalName="QuicNet.Updates.release-public.pem" /></ItemGroup>
<ItemGroup>
  <PackageReference Include="ZstdSharp.Port" Version="0.8.8" />
</ItemGroup></Project>
