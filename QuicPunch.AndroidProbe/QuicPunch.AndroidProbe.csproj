<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../Release.props" />
  <PropertyGroup>
    <TargetFramework>net11.0-android37.0</TargetFramework>
    <SupportedOSPlatformVersion>29</SupportedOSPlatformVersion>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RuntimeIdentifier>android-arm64</RuntimeIdentifier>
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>
    <AndroidExtractNativeLibs>true</AndroidExtractNativeLibs>
    <ApplicationId>org.quicpunch.androidprobe</ApplicationId>
    <ApplicationId Condition="'$(RuntimeIdentifier)' == 'android-x64'">org.quicpunch.androidprobe.qa</ApplicationId>
    <AndroidManifestPlaceholders>quicNetApplicationId=$(ApplicationId)</AndroidManifestPlaceholders>
    <ApplicationVersion>$(ReleaseNumber)</ApplicationVersion>
    <ApplicationDisplayVersion>$(ReleaseVersion)</ApplicationDisplayVersion>
    <ApplicationDisplayVersion Condition="'$(ReleaseChannel)' == 'beta'">$(ReleaseVersion)-beta</ApplicationDisplayVersion>
    <!-- Trim unused framework code and keep application assemblies intact. -->
    <TrimMode>partial</TrimMode>
  </PropertyGroup>
  <ItemGroup>
    <AndroidNativeLibrary Include="bin/native-tests/arm64-v8a/libnettt_test_pattern.so" Condition="'$(RuntimeIdentifier)' == 'android-arm64' and '$(Configuration)' == 'Debug' and Exists('bin/native-tests/arm64-v8a/libnettt_test_pattern.so')" Link="lib/arm64-v8a/libnettt_test_pattern.so" />
    <Compile Include="../QuicPunch.AndroidProbe.Shared/QuicProbe.cs" Link="QuicProbe.cs" />
    <ProjectReference Include="..\QuicNet.Shared\QuicNet.Shared.csproj" />
    <AndroidAsset Include="../QuicNet.Geolocation/Data/NOTICE.txt" Link="Assets/GEOLOCATION-NOTICE.txt" />
    <AndroidNativeLibrary Include="../QuicPunch/runtimes/android-arm64/native/libmsquic.so" Condition="'$(RuntimeIdentifier)' == 'android-arm64'"
                          Link="lib/arm64-v8a/libmsquic.so" />
  </ItemGroup>
  <ItemGroup Condition="'$(RuntimeIdentifier)' == 'android-x64'">
    <AndroidNativeLibrary Remove="native/arm64-v8a/*.so" />
    <AndroidNativeLibrary Include="bin/native/x86_64/*.so" Link="lib/x86_64/%(Filename)%(Extension)" />
    <_EmulatorLibrary Include="libmsquic;libqp_transport;libqp_probe;libtor;libnettt_media;libavcodec;libavutil;libswscale" />
  </ItemGroup>
  <Target Name="RequireAndroidEmulatorLibraries" BeforeTargets="PrepareForBuild" Condition="'$(RuntimeIdentifier)' == 'android-x64'">
    <Error Condition="!Exists('bin/native/x86_64/%(_EmulatorLibrary.Identity).so')"
           Text="Missing x86_64 library %(_EmulatorLibrary.Identity).so. Run build-native-android.sh x86_64, scripts/build-native-media.sh android-x64 and prepare-tor-android.ps1 -Abi x86_64." />
  </Target>
  <Target Name="RequireAndroidMsQuic" BeforeTargets="Build" Condition="'$(RuntimeIdentifier)' == 'android-arm64'">
    <Error Condition="!Exists('native/arm64-v8a/libnettt_media.so') or !Exists('native/arm64-v8a/libavcodec.so') or !Exists('native/arm64-v8a/libavutil.so') or !Exists('native/arm64-v8a/libswscale.so')" Text="Build the native FFmpeg libraries with scripts/build-native-media.sh android-arm64 before packaging." />
    <Error Condition="!Exists('native/arm64-v8a/libtor.so')"
           Text="Run QuicPunch.AndroidProbe/prepare-tor-android.ps1 before packaging the Android Tor runtime." />
    <Error Condition="!Exists('../QuicPunch/runtimes/android-arm64/native/libmsquic.so')"
           Text="Build the Android ARM64 MsQuic/OpenSSL PQC library before packaging this probe." />
    <Error Condition="!Exists('native/arm64-v8a/libqp_transport.so')"
           Text="Build the Android ARM64 QUIC transport bridge before packaging this probe." />
  </Target>
  <!-- Keep the easy-to-find Debug/Release APK in sync with the self-contained ARM64 build.
       A stale non-RID APK at this path omits the assembly store and crashes at startup. -->
  <Target Name="CopyInstallableAndroidApk" AfterTargets="Build"
          Condition="'$(RuntimeIdentifier)' == 'android-arm64' and '$(Configuration)' == 'Debug'">
    <PropertyGroup>
      <_InstallableApk>$(OutputPath)$(ApplicationId)-Signed.apk</_InstallableApk>
      <_TopLevelApk>$(MSBuildProjectDirectory)/bin/$(Configuration)/$(TargetFramework)/$(ApplicationId)-Signed.apk</_TopLevelApk>
    </PropertyGroup>
    <Error Condition="!Exists('$(_InstallableApk)')"
           Text="The self-contained ARM64 APK was not produced at $(_InstallableApk)." />
    <Copy SourceFiles="$(_InstallableApk)" DestinationFiles="$(_TopLevelApk)" />
    <Message Importance="high" Text="Installable Android APK: $(_TopLevelApk)" />
  </Target>
</Project>
