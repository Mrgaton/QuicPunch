<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyName>QuicPunch.Vpn</AssemblyName>
    <RootNamespace>QuicPunch.Vpn</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="QuicPunchTests" />
    <InternalsVisibleTo Include="QuicPunch.Vpn.Tests" />
    <InternalsVisibleTo Include="QuicNet" />
  </ItemGroup>

  <ItemGroup>
    <None Include="wintun.dll" Condition="Exists('wintun.dll')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>

</Project>
