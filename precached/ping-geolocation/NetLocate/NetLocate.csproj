<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeFrameworkVersion>10.0.13</RuntimeFrameworkVersion>
    <AssemblyName>NetLocate</AssemblyName>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>14.0</LangVersion>
    <PublishAot>true</PublishAot>
    <IsAotCompatible>true</IsAotCompatible>
    <EnableAotAnalyzer>true</EnableAotAnalyzer>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="*.cs" />
    <Compile Include="../QuicNet.Geolocation/Core/*.cs;../QuicNet.Geolocation/EmbeddedCatalog.cs;../QuicNet.Geolocation/IpCatalogTable.cs;../QuicNet.Geolocation/ProgressiveLocator.cs;../QuicNet.Geolocation/EvidenceReconciler.cs" Link="Engine/%(Filename)%(Extension)" />
    <EmbeddedResource Include="../QuicNet.Geolocation/Data/anchors.json.gz;../QuicNet.Geolocation/Data/asn.bin;../QuicNet.Geolocation/Data/manifest.json" LogicalName="GeoData.%(Filename)%(Extension)" />
    <EmbeddedResource Include="NOTICE.txt" LogicalName="GeoData.NOTICE.txt" />
    <EmbeddedResource Include="Data/regional-probes.json.gz" LogicalName="NetLocate.RegionalProbes.gz" />
    <EmbeddedResource Include="Data/regional-manifest.json" LogicalName="NetLocate.RegionalManifest.json" />
    <EmbeddedResource Include="../LICENSE.txt" LogicalName="NetLocate.LICENSE" />
    <EmbeddedResource Include="../QuicNet.Geolocation/Map/map.json.gz" LogicalName="NetLocate.Map.gz" />
    <EmbeddedResource Include="../QuicNet.Geolocation/Map/NOTICE.txt" LogicalName="NetLocate.MapNotice" />
  </ItemGroup>
</Project>
