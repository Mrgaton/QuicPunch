<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PublishAot>false</PublishAot>
    <PublishTrimmed>false</PublishTrimmed>
    <Version>1.1.0</Version>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../QuicNet.Geolocation/QuicNet.Geolocation.csproj" />
    <EmbeddedResource Include="../QuicNet.Geolocation/Map/map.json.gz" LogicalName="GeoLatency.Map.gz" />
    <EmbeddedResource Include="Diagnostics/Fixtures/*.json" />
    <Content Include="../QuicNet.Geolocation/Map/NOTICE.txt" Link="MAP-NOTICE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../QuicNet.Geolocation/Map/map.js" Link="wwwroot/map.js" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <Content Include="../QuicNet.Geolocation/Data/NOTICE.txt" Link="DATA-NOTICE.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Update="README.md;GeoLatency.cmd" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
